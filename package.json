{
  "name": "modpack-utility",
  "version": "0.1.1",
  "description": "Detect, inspect and tune Minecraft instances across launchers",
  "main": "./out/main/index.js",
  "author": "simplefox",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check:config": "esbuild scripts/check-config-io.ts --bundle --platform=node --format=cjs --outfile=out/check-config-io.cjs --alias:@shared=./src/shared --log-level=warning && node out/check-config-io.cjs",
    "scan": "esbuild scripts/scan-report.ts --bundle --platform=node --format=cjs --outfile=out/scan-report.cjs --alias:@shared=./src/shared --log-level=warning && node out/scan-report.cjs",
    "package": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "dev.simplefox.modpackutility",
    "productName": "Modpack Utility",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HexagonUBI",
        "repo": "Modpack-Utility"
      }
    ],
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/renderer/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Modpack Utility",
      "artifactName": "Modpack-Utility-${version}-Setup.${ext}",
      "uninstallDisplayName": "Modpack Utility ${version}"
    },
    "portable": {
      "artifactName": "Modpack-Utility-${version}-Portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/comfortaa": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@mui/icons-material": "^9.3.0",
    "@mui/material": "^9.3.0",
    "d3-hierarchy": "^3.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
